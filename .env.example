# =============================================================================
# CAN Security Framework — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values.
# NEVER commit the .env file with real secrets.
# =============================================================================

# System
CAN_SECURITY_MODE=simulation
CAN_SECURITY_LOG_LEVEL=INFO

# CAN Interface
CAN_INTERFACE=virtual
CAN_SOCKETCAN_CHANNEL=vcan0

# Database
DATABASE_URL=sqlite+aiosqlite:///data/can_security.db

# Authentication Keys — REPLACE WITH REAL KEYS IN DEPLOYMENT
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CAN_AUTH_KEY_001=REPLACE_WITH_GENERATED_KEY
CAN_AUTH_KEY_VERSION=1

# API
API_HOST=0.0.0.0
API_PORT=8000

# ML
ML_MODEL_PATH=ml/models/
ML_MODEL_TYPE=random_forest
